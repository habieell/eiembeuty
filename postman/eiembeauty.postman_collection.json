{
  "info": {
    "name": "eiem.beauty localhost API",
    "description": "Jalankan dengan environment eiembeauty localhost. Cookie jar harus aktif. Registrasi menghasilkan nomor otomatis bila phone kosong; checkout contoh 5 EI-A01 + 3 EI-A03. Data pengujian tersimpan pada database lokal.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP [200]\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
              "pm.test(\"Database siap\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Distributor",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/distributors"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP [200]\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
              "pm.test(\"Dua distributor seed\", () => pm.expect(pm.response.json().length).to.eql(2));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Outlet STD",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/outlets?distributor=STD"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP [200]\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
              "pm.test(\"Outlet distributor STD\", () => pm.expect(pm.response.json().map(x=>x.kode_outlet)).to.include(\"BAL-STD-00240\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Outlet JKT",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/outlets?distributor=JKT"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP [200]\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
              "pm.test(\"Outlet terfilter\", () => pm.expect(pm.response.json().map(x=>x.kode_outlet)).to.eql([\"JKT-001\"]));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Registrasi",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"{{phone}}\",\n  \"user_name\": \"Postman Demo\",\n  \"password\": \"{{password}}\",\n  \"kode_distributor\": \"STD\",\n  \"kode_outlet\": \"BAL-STD-00240\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get(\"phone\")) pm.environment.set(\"phone\", \"08\" + Date.now().toString().slice(-10));",
              "pm.environment.set(\"idempotency_key\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP [201, 409]\", function () { pm.expect(pm.response.code).to.be.oneOf([201, 409]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Login salah - validasi",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"{{phone}}\",\n  \"password\": \"wrong-password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP [401]\", function () { pm.expect(pm.response.code).to.be.oneOf([401]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone_number\": \"{{phone}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP [200]\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
              "pm.test(\"Akun dan outlet benar\", () => pm.expect(pm.response.json().kode_outlet).to.eql(\"BAL-STD-00240\"));",
              "pm.test(\"Cookie HttpOnly\", () => pm.expect(pm.response.headers.get(\"Set-Cookie\")).to.include(\"HttpOnly\"));"
            ]
          }
        }
      ]
    },
