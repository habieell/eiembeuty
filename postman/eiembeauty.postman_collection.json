    {
      "name": "10 Preview checkout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/checkout/preview",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"kode_sku\": \"EI-A01\",\n      \"quantity\": 5\n    },\n    {\n      \"kode_sku\": \"EI-A03\",\n      \"quantity\": 3\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP [200]\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
              "pm.test(\"8 unit Rp300000\", () => { const x=pm.response.json(); pm.expect(x.total_quantity).to.eql(8); pm.expect(x.total_price).to.eql(300000); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Tolak kuantitas nol",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "invalid-quantity-test-key"
          }
        ],
        "url": "{{base_url}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"kode_sku\": \"EI-A01\",\n      \"quantity\": 0\n    }\n  ],\n  \"expected_total\": 300000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP [400]\", function () { pm.expect(pm.response.code).to.be.oneOf([400]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Simpan pesanan",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_key}}"
          }
        ],
        "url": "{{base_url}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"kode_sku\": \"EI-A01\",\n      \"quantity\": 5\n    },\n    {\n      \"kode_sku\": \"EI-A03\",\n      \"quantity\": 3\n    }\n  ],\n  \"expected_total\": 300000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP [200, 201]\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
              "pm.test(\"Order number tersedia\", () => pm.expect(pm.response.json().order_number).to.match(/^CAS-/));",
              "pm.environment.set(\"order_number\", pm.response.json().order_number);"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Retry pesanan yang sama",
      "request": {
        "method": "POST",
        "header": [
          {
