        ],
        "url": "{{base_url}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"kode_sku\": \"EI-A01\",\n      \"quantity\": 5\n    },\n    {\n      \"kode_sku\": \"EI-A03\",\n      \"quantity\": 3\n    }\n  ],\n  \"expected_total\": 300000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP [200]\", function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
              "pm.test(\"Tidak duplikat\", () => {pm.expect(pm.response.json().order_number).to.eql(pm.environment.get(\"order_number\"));pm.expect(pm.response.json().replayed).to.eql(true);});"
            ]
          }
        }
      ]
    },
